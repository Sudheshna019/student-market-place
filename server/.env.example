# Copy this file to server/.env for local development.
# On Vercel, add the same keys under Project Settings -> Environment Variables.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers). Include a database name, e.g. /student_marketplace
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/student_marketplace?retryWrites=true&w=majority

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Local API port (not used on Vercel)
PORT=5000

# Only needed if the frontend is hosted on a different domain than the API
# CLIENT_ORIGIN=https://your-frontend.example.com
